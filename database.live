Table: intelligence_keys, Model: IntelligenceKey
Fields:
> id: int, auto incremental;
> provider: string;
> model: string, nullable;
> key: string;
> addedOn: timestamp, default: current timestamp;
> updatedOn: timestamp, automatically updated;
> balance: decimal(20, 8), nullable;

Table: accounts, Model: Account
Fields:
> id: string, primary key, supplied by NeupID;
> type: string;
> displayName: string;
> displayImage: string, nullable;
> neupId: string, nullable;
> status: string;

Table: chats, Model: Chat
Fields:
> id: int, auto incremental;
> title: string;
> account_id: string, nullable, references accounts.id;
> status: enum(served, toserve, paused, completed), default: toserve;
> lastUpdated: timestamp, automatically updated;

Table: messages, Model: Message
Fields:
> id: int, auto incremental;
> chat_id: int, references chats.id;
> type: enum(intelligenceReply, userSent, notification);
> content: text;
> sent_on: timestamp, default: current timestamp;
> sent_by: string, nullable, references accounts.id;

Table: applications, Model: Application
Fields:
> id: uuid, generated by PostgreSQL;
> name: string;
> description: text;
> category: string;
> instructions: text;
> endpoints: jsonb;
> authMethod: string;
> moreDetails: text, nullable;
> displayImage: string, nullable;
> coverImage: string, nullable;

Table: integrations, Model: Integration
Fields:
> id: int, auto incremental;
> application_id: uuid, references applications.id;
> account_id: string, references accounts.id;
> auth_info: string(2048);
> status: string, default: active;
> addedOn: timestamp, default: current timestamp;
