{
  "name": "nia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "neup.cloner": "test -d ./@neup/setup || (mkdir -p ./@neup && cd ./@neup && git clone --depth 1 --single-branch --branch main https://github.com/neupgroup/nextjs.setup.git nextjs.setup && mv nextjs.setup setup)",
    "setup": "npm run neup.cloner && cd ./@neup && chmod +x ./setup/index.sh && ./setup/index.sh",
    "preinstall": "npm run setup -- --mode preinstall",
    "postinstall": "npm run setup -- --mode postinstall",
    "prebuild": "npm run setup -- --mode prebuild",
    "postbuild": "npm run setup -- --mode postbuild",
    "predev": "npm run setup -- --mode predev",
    "dev": "next dev --experimental-https --hostname dev.neupgroup.com --port 64263",
    "build": "prisma generate && next build",
    "start": "next start --port 64263",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.5.0",
    "next": "16.4.3",
    "pg": "^8.17.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8",
    "prisma": "7.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
  "type": "module"
}
