generator client {
  provider = "prisma-client"
  output   = "./client/generated"
}

datasource db {
  provider = "postgresql"
}

enum ChatStatus {
  served
  toserve
  paused
  completed
}

enum MessageType {
  intelligenceReply
  userSent
  notification
}

model IntelligenceKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider  String
  model     String?
  key       String
  addedOn   DateTime @default(now()) @db.Timestamp(3)
  updatedOn DateTime @updatedAt @db.Timestamp(3)
  balance   Decimal? @db.Decimal(20, 8)

  @@map("intelligence_keys")
}

model Account {
  id           String  @id
  type         String
  displayName  String
  displayImage String?
  neupId       String?
  status       String
  chats        Chat[]
  messages     Message[]
  integrations Integration[]
  callerLogs   CallerLog[]
  callerKeys   CallerKey[]

  @@map("accounts")
}

model CallerKey {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id String
  account    Account  @relation(fields: [account_id], references: [id], onDelete: Cascade)
  key        String
  added_on   DateTime @default(now()) @db.Timestamp(3)
  expired_on DateTime @db.Timestamp(3)
  usage      CallerUsage[]

  @@index([key])
  @@index([account_id])
  @@map("caller_keys")
}

model Chat {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  account_id  String?
  account     Account?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
  status      ChatStatus   @default(toserve)
  lastUpdated DateTime     @updatedAt @db.Timestamp(3)
  messages    Message[]

  @@map("chats")
}

model Message {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_id  String      @db.Uuid
  chat     Chat        @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  type     MessageType
  content  String      @db.Text
  sent_on  DateTime    @default(now()) @db.Timestamp(3)
  sent_by  String?
  sender   Account?    @relation(fields: [sent_by], references: [id], onDelete: SetNull)

  @@index([chat_id, sent_on])
  @@map("messages")
}

model Application {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  description   String         @db.Text
  category      String
  instructions  String         @db.Text
  endpoints     Json           @db.JsonB
  authMethod    String
  moreDetails   String?        @db.Text
  displayImage  String?
  coverImage    String?
  integrations  Integration[]
  callerLogs    CallerLog[]

  @@map("applications")
}

model Integration {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id String      @db.Uuid
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  account_id     String
  account        Account     @relation(fields: [account_id], references: [id], onDelete: Cascade)
  auth_info      String      @db.VarChar(2048)
  status         String      @default("active")
  addedOn        DateTime    @default(now()) @db.Timestamp(3)

  @@index([application_id])
  @@index([account_id])
  @@map("integrations")
}

model CallerLog {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id     String?
  account        Account?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
  application_id String?      @db.Uuid
  application    Application? @relation(fields: [application_id], references: [id], onDelete: SetNull)
  log            Json         @db.JsonB
  timestamp      DateTime     @default(now()) @db.Timestamp(3)

  @@index([account_id, timestamp])
  @@index([application_id, timestamp])
  @@map("caller_logs")
}

model CallerUsage {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callerkey_id String    @db.Uuid
  callerkey    CallerKey @relation(fields: [callerkey_id], references: [id], onDelete: Cascade)
  input_token  Int
  output_token Int
  cost         Decimal   @db.Decimal(18, 16)
  created_at   DateTime  @default(now()) @db.Timestamp(3)

  @@index([callerkey_id, created_at])
  @@map("caller_usage")
}
